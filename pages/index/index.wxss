page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #eef4ef;
}

.container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #f7faf8;
}

.page-glow {
  position: absolute;
  top: -96rpx;
  right: -84rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(0, 160, 96, 0.08);
}

.brand {
  position: absolute;
  top: 20rpx;
  left: 48rpx;
  width: 234rpx;
  height: 38rpx;
  z-index: 2;
}

.brand-logo {
  width: 100%;
  height: 100%;
  display: block;
}

.content {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  padding: 56rpx 48rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 14rpx;
}

.title {
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #1f2933;
  text-align: center;
}

.subtitle {
  margin-top: 6rpx;
  font-size: 12rpx;
  line-height: 18rpx;
  color: #667085;
  text-align: center;
}

.notice-card {
  width: 532rpx;
  padding: 14rpx 19rpx;
  margin-bottom: 14rpx;
  box-sizing: border-box;
  border-radius: 11rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.07);
}

.notice-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 8rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx dashed rgba(0, 155, 99, 0.2);
}

.notice-bar {
  width: 3rpx;
  height: 14rpx;
  margin-right: 6rpx;
  border-radius: 999rpx;
  background: #009b63;
}

.notice-title {
  font-size: 16rpx;
  line-height: 20rpx;
  font-weight: 600;
  color: #009b63;
}

.notice-list {
  display: flex;
  flex-direction: column;
}

.notice-item {
  display: flex;
  align-items: flex-start;
}

.notice-item + .notice-item {
  margin-top: 6rpx;
}

.index-badge {
  flex: 0 0 17rpx;
  width: 17rpx;
  height: 17rpx;
  margin-top: 1rpx;
  margin-right: 6rpx;
  border-radius: 50%;
  background: rgba(0, 155, 99, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.index-text {
  font-size: 10rpx;
  line-height: 1;
  font-weight: 600;
  color: #008f55;
}

.notice-text {
  flex: 1;
  font-size: 12rpx;
  line-height: 18rpx;
  color: #263238;
}

.actions {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.start-button {
  width: 172rpx;
  height: 38rpx;
  padding: 0;
  border: none;
  border-radius: 8rpx;
  background: #009b63;
  color: #ffffff;
  font-size: 13rpx;
  line-height: 38rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 7rpx 16rpx rgba(0, 155, 99, 0.2);
}

.start-button::after {
  border: none;
}

.start-button:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.permission-note {
  margin-top: 6rpx;
  font-size: 9rpx;
  line-height: 14rpx;
  color: #8a8f98;
  text-align: center;
  white-space: nowrap;
}

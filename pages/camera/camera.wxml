<view class="container" style="{{cameraLayout.containerStyle}}">
  <view class="page-glow"></view>

  <view class="info-area" style="{{cameraLayout.infoAreaStyle}}">
    <view class="vehicle-info" style="{{cameraLayout.cardStyle}}">
      <text class="vehicle-label" style="{{cameraLayout.labelTextStyle}}">当前车辆</text>
      <view class="vehicle-main">
        <text class="vehicle-role" style="{{cameraLayout.primaryTextStyle}}">{{vehicleRoleName}}</text>
        <text wx:if="{{vehicleProgressText}}" class="vehicle-progress">{{vehicleProgressText}}</text>
      </view>
      <text class="vehicle-plate vehicle-plate-{{vehiclePlateTheme}}">{{vehiclePlateNo}}</text>
    </view>

    <view wx:if="{{currentStep !== 'damage'}}" class="step-info" style="{{cameraLayout.cardStyle}}">
      <text class="step-label" style="{{cameraLayout.labelTextStyle}}">拍摄步骤</text>
      <text class="step-name" style="{{cameraLayout.secondaryTextStyle}}">{{currentStep === 'licensePlate' ? '1、车牌号' : '2、VIN码'}}</text>
    </view>

    <view wx:if="{{currentStep === 'damage'}}" class="damage-info" style="{{cameraLayout.cardStyle}}">
      <view class="damage-count">
        <text class="count-label" style="{{cameraLayout.labelTextStyle}}">车损照片</text>
        <text class="count-value" style="{{cameraLayout.primaryTextStyle}}">{{damageCount}}/5 张</text>
        <text wx:if="{{vehicleProgressText}}" class="vehicle-progress damage-progress">{{vehicleProgressText}}</text>
      </view>

      <view wx:if="{{damageCount === 0}}" class="damage-tip">
        <text style="{{cameraLayout.damageTipTextStyle}}">请对准车损处，稳定后自动拍照</text>
      </view>
    </view>

    <view class="preview-btn" style="{{cameraLayout.actionButtonStyle}}" bindtap="onGoPreview">
      <text class="preview-text" style="{{cameraLayout.actionButtonTextStyle}}">查看已拍</text>
    </view>

    <view wx:if="{{currentStep === 'damage' && damageCount > 0}}" class="finish-btn" style="{{cameraLayout.actionButtonStyle}}" bindtap="onFinishDamage">
      <text class="finish-text" style="{{cameraLayout.actionButtonTextStyle}}">{{finishDamageText}}</text>
    </view>
  </view>

  <view class="camera-wrapper" style="{{cameraLayout.cameraWrapperStyle}}">
    <camera
      wx:if="{{!showConfirmModal}}"
      class="camera"
      device-position="back"
      flash="auto"
      frame-size="medium"
      binderror="onCameraError"
      bindstop="onCameraStop"
      bindinitdone="onCameraInitDone"
    >
      <cover-view class="guide-container">
        <cover-view
          wx:if="{{currentStep === 'licensePlate'}}"
          class="guide-frame guide-frame-license guide-frame-license-{{plateFrameState}}"
          style="{{cameraLayout.plateFrameStyle}} {{cameraLayout.guideFrameStyle}}"
        ></cover-view>
        <cover-view
          wx:if="{{currentStep === 'licensePlate' && plateDistanceHint}}"
          class="plate-distance-hint plate-distance-hint-{{plateDistanceHint}}"
        >
          <cover-view class="plate-distance-arrows">
            <cover-view class="plate-distance-frame" hidden="{{plateBlinkFrame !== 'a'}}">
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-1"
                src="{{plateDistanceHint === 'forward' ? '/assets/arrow-up-blue.png' : '/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-2"
                src="{{plateDistanceHint === 'forward' ? '/assets/arrow-up-white.png' : '/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-3"
                src="{{plateDistanceHint === 'forward' ? '/assets/arrow-up-blue.png' : '/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-4"
                src="{{plateDistanceHint === 'forward' ? '/assets/arrow-up-white.png' : '/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-5"
                src="{{plateDistanceHint === 'forward' ? '/assets/arrow-up-blue.png' : '/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-6"
                src="{{plateDistanceHint === 'forward' ? '/assets/arrow-up-white.png' : '/assets/arrow-down-white.png'}}"
              ></cover-image>
            </cover-view>
            <cover-view class="plate-distance-frame" hidden="{{plateBlinkFrame !== 'b'}}">
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-1"
                src="{{plateDistanceHint === 'forward' ? '/assets/arrow-up-white.png' : '/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-2"
                src="{{plateDistanceHint === 'forward' ? '/assets/arrow-up-blue.png' : '/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-3"
                src="{{plateDistanceHint === 'forward' ? '/assets/arrow-up-white.png' : '/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-4"
                src="{{plateDistanceHint === 'forward' ? '/assets/arrow-up-blue.png' : '/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-5"
                src="{{plateDistanceHint === 'forward' ? '/assets/arrow-up-white.png' : '/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-6"
                src="{{plateDistanceHint === 'forward' ? '/assets/arrow-up-blue.png' : '/assets/arrow-down-blue.png'}}"
              ></cover-image>
            </cover-view>
          </cover-view>
        </cover-view>
        <cover-view
          wx:if="{{currentStep === 'vinCode'}}"
          class="guide-frame guide-frame-vin"
          style="{{cameraLayout.guideFrameStyle}}"
        ></cover-view>
        <cover-view
          wx:if="{{currentStep === 'damage'}}"
          class="guide-frame guide-frame-damage guide-frame-damage-{{damageFrameState}}"
          style="{{cameraLayout.damageFrameStyle}} {{cameraLayout.guideFrameStyle}}"
        >
          <cover-view class="cross-h" style="{{cameraLayout.crossHStyle}}"></cover-view>
          <cover-view class="cross-v" style="{{cameraLayout.crossVStyle}}"></cover-view>
        </cover-view>
        <cover-view
          wx:if="{{currentStep === 'damage' && damageDistanceHint}}"
          class="damage-distance-hint"
        >
          <cover-view class="damage-distance-arrows">
            <cover-view class="damage-distance-frame" hidden="{{plateBlinkFrame !== 'a'}}">
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-1"
                src="{{damageDistanceHint === 'forward' ? '/assets/arrow-up-blue.png' : '/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-2"
                src="{{damageDistanceHint === 'forward' ? '/assets/arrow-up-white.png' : '/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-3"
                src="{{damageDistanceHint === 'forward' ? '/assets/arrow-up-blue.png' : '/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-4"
                src="{{damageDistanceHint === 'forward' ? '/assets/arrow-up-white.png' : '/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-5"
                src="{{damageDistanceHint === 'forward' ? '/assets/arrow-up-blue.png' : '/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-6"
                src="{{damageDistanceHint === 'forward' ? '/assets/arrow-up-white.png' : '/assets/arrow-down-white.png'}}"
              ></cover-image>
            </cover-view>
            <cover-view class="damage-distance-frame" hidden="{{plateBlinkFrame !== 'b'}}">
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-1"
                src="{{damageDistanceHint === 'forward' ? '/assets/arrow-up-white.png' : '/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-2"
                src="{{damageDistanceHint === 'forward' ? '/assets/arrow-up-blue.png' : '/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-3"
                src="{{damageDistanceHint === 'forward' ? '/assets/arrow-up-white.png' : '/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-4"
                src="{{damageDistanceHint === 'forward' ? '/assets/arrow-up-blue.png' : '/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-5"
                src="{{damageDistanceHint === 'forward' ? '/assets/arrow-up-white.png' : '/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-6"
                src="{{damageDistanceHint === 'forward' ? '/assets/arrow-up-blue.png' : '/assets/arrow-down-blue.png'}}"
              ></cover-image>
            </cover-view>
          </cover-view>
        </cover-view>

        <cover-view class="guide-tip tip-{{currentStep}}" style="{{cameraLayout.guideTipStyle}}">
          {{currentStep === 'vinCode' ? vinGuideTip : guideTip}}
        </cover-view>

        <cover-view
          wx:if="{{currentStep === 'damage' && showDamageDebug && damageAreaRatioText}}"
          class="damage-debug"
          style="{{cameraLayout.damageDebugStyle}}"
        >
          {{damageAreaRatioText}}
        </cover-view>

        <cover-view wx:if="{{aiStatusText}}" class="ai-tip {{aiLocked ? 'ai-tip-locked' : ''}}" style="{{cameraLayout.aiTipStyle}}">
          {{aiStatusText}}
        </cover-view>
      </cover-view>
    </camera>

    <view wx:if="{{showConfirmModal}}" class="photo-preview">
      <image class="preview-image" src="{{pendingPhoto.compressedPath}}" mode="aspectFill"></image>
    </view>
  </view>

  <view class="action-area" style="{{cameraLayout.actionAreaStyle}}">
    <view wx:if="{{!showConfirmModal}}" class="capture-section">
      <view class="capture-btn" style="{{cameraLayout.captureButtonStyle}}" bindtap="onCapture">
        <view class="capture-inner" style="{{cameraLayout.captureInnerStyle}}"></view>
      </view>
      <text class="capture-text" style="{{cameraLayout.captureTextStyle}}">{{aiEnabled && aiAvailable ? '手动拍照' : '点击拍照'}}</text>
    </view>

    <view wx:if="{{showConfirmModal}}" class="confirm-section" style="{{cameraLayout.confirmSectionStyle}}">
      <text wx:if="{{qualityHintText}}" class="quality-hint" style="{{cameraLayout.qualityHintStyle}}">{{qualityHintText}}</text>
      <view class="btn-group">
        <view class="btn-confirm" style="{{cameraLayout.confirmButtonStyle}}" bindtap="onConfirmPhoto">
          <text>{{confirmUseText}}</text>
        </view>
        <view class="btn-retake" style="{{cameraLayout.confirmButtonStyle}}" bindtap="onRetakePhoto">
          <text>{{retakeText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{appEnvBadgeText}}" class="env-badge">{{appEnvBadgeText}}</view>
</view>

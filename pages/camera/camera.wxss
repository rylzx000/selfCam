  transform: translateX(-50%);
  width: 100%;
  height: 100%;
}

.plate-distance-frame {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.plate-distance-arrow {
  position: absolute;
  left: 50%;
  width: 80.4348%;
  height: 26.087%;
  transform: translateX(-50%);
}

.plate-distance-arrow-1 {
  top: 65.2174%;
}

.plate-distance-arrow-2 {
  top: 52.1739%;
}

.plate-distance-arrow-3 {
  top: 39.1304%;
}

.plate-distance-arrow-4 {
  top: 26.087%;
}

.plate-distance-arrow-5 {
  top: 13.0435%;
}

.plate-distance-arrow-6 {
  top: 0;
}



/* 璺濈寮曞绠ご娴?*/
.guide-frame-vin {
  width: 80%;
  height: 13.3333%;
  border-radius: 4rpx;
  bottom: 16.6667%;
  left: 50%;
  transform: translateX(-50%);
}

/* 杞︽崯杈呭姪妗?*/
.guide-frame-damage {
  width: 33%;
  height: 44%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  position: absolute;
}

.guide-frame-damage-active {
  border-color: #29B6F6;
  box-shadow: 0 0 0 2rpx rgba(41, 182, 246, 0.24);
  background-color: rgba(41, 182, 246, 0.08);
}

.guide-frame-damage-locked {
  border-color: #1565C0;
  box-shadow: 0 0 0 3rpx rgba(21, 101, 192, 0.28);
  background-color: rgba(21, 101, 192, 0.10);
}

.damage-distance-hint {
  position: absolute;
  left: 50%;
  top: 8.6667%;
  transform: translateX(-50%);
  width: 41%;
  height: 21.3333%;
  z-index: 4;
  pointer-events: none;
}

.damage-distance-arrows {
  position: absolute;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
  width: 100%;
  height: 100%;
}

.damage-distance-frame {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.damage-distance-arrow {
  position: absolute;
  left: 50%;
  width: 80.4878%;
  height: 31.25%;
  transform: translateX(-50%);
}

.damage-distance-arrow-1 {
  top: 68.75%;
}

.damage-distance-arrow-2 {
  top: 54.6875%;
}

.damage-distance-arrow-3 {
  top: 40.625%;
}

.damage-distance-arrow-4 {
  top: 26.5625%;
}

.damage-distance-arrow-5 {
  top: 12.5%;
}

.damage-distance-arrow-6 {
  top: 0;
}

/* 鍗佸瓧鍑嗘槦 */
.cross-h {
  width: 18.1818%;
  height: 2rpx;
  background-color: rgba(255, 255, 255, 0.5);
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.cross-v {
  width: 2rpx;
  height: 18.1818%;
  background-color: rgba(255, 255, 255, 0.5);
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

/* 鍙充晶鎿嶄綔鍖?*/
.action-area {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 120rpx;
}

/* 鎷嶇収鎸夐挳鍖?*/
.capture-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.capture-btn {
  width: 76rpx;
  height: 76rpx;
  background-color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(76, 175, 80, 0.4);
  transition: all 0.2s ease;
}

.capture-inner {
  width: 58rpx;
  height: 58rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
  border-radius: 50%;
  transition: transform 0.15s ease;
}

.capture-btn:active .capture-inner {
  transform: scale(0.9);
}

.capture-text {
  font-size: 12rpx;
  color: #9E9E9E;
  margin-top: 8rpx;
  white-space: nowrap;
}

/* 纭鍖?*/
.confirm-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 8rpx;
  padding: 14rpx 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.confirm-tip {
  font-size: 14rpx;
  color: #212121;
  margin-bottom: 12rpx;
  text-align: center;
  line-height: 1.4;
  white-space: nowrap;
}

.quality-hint {
  max-width: 220rpx;
  font-size: 12rpx;
  color: #8A5A00;
  background-color: #FFF7E6;
  border: 1rpx solid #F2D39B;
  border-radius: 12rpx;
  padding: 8rpx 12rpx;
  margin-bottom: 12rpx;
  text-align: center;
  line-height: 1.5;
}

.btn-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.btn-retake,
.btn-confirm {
  width: 80rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14rpx;
  transition: all 0.2s ease;
}

.btn-retake {
  background-color: transparent;
  color: #9E9E9E;
  border: 1rpx solid #EEEEEE;
}

.btn-confirm {
  background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
  color: #FFFFFF;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.3);
}

.btn-retake:active {
  background-color: #FAFAFA;
  transform: scale(0.98);
}

.btn-confirm:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 鐓х墖棰勮 */
.photo-preview {
  width: 100%;
  height: 100%;
}

.preview-image {
  width: 100%;
  height: 100%;
}

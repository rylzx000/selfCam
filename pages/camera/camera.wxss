/* 鎷嶇収椤垫牱寮?*/

page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #eef4ef;
}

.container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #f7faf8;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
  gap: 24rpx;
}

.page-glow {
  position: absolute;
  top: -92rpx;
  right: -78rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: rgba(0, 160, 96, 0.08);
  z-index: 0;
  pointer-events: none;
}

/* 宸︿晶淇℃伅鍖?*/
.info-area {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  flex-shrink: 0;
  width: 120rpx;
}

.vehicle-info,
.step-info {
  background-color: #FFFFFF;
  border-radius: 8rpx;
  padding: 14rpx 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.vehicle-label,
.step-label {
  font-size: 12rpx;
  color: #9E9E9E;
  margin-bottom: 4rpx;
}

.vehicle-name {
  font-size: 18rpx;
  color: #212121;
  font-weight: 500;
  max-width: 100%;
  line-height: 22rpx;
  text-align: center;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.vehicle-main {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.vehicle-role {
  font-size: 18rpx;
  color: #212121;
  font-weight: 600;
  max-width: 100%;
  line-height: 22rpx;
  text-align: center;
  white-space: nowrap;
}

.vehicle-progress {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  box-sizing: border-box;
  padding: 2rpx 6rpx;
  border-radius: 999rpx;
  background-color: #EEF7F0;
  color: #2E7D32;
  font-size: 11rpx;
  line-height: 15rpx;
  font-weight: 600;
  white-space: nowrap;
}

.vehicle-plate {
  display: block;
  max-width: 100%;
  box-sizing: border-box;
  margin-top: 8rpx;
  padding: 3rpx 7rpx;
  border-radius: 4rpx;
  color: #FFFFFF;
  font-size: 14rpx;
  line-height: 18rpx;
  font-weight: 600;
  text-align: center;
  white-space: normal;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.vehicle-plate-oil {
  background-color: #1565C0;
}

.vehicle-plate-electric {
  background-color: #1B8F4A;
}

.vehicle-plate-unknown {
  background-color: #E0E0E0;
  color: #424242;
}

.step-name {
  font-size: 16rpx;
  color: #4CAF50;
  font-weight: 500;
  white-space: nowrap;
}

/* 鏌ョ湅宸叉媿鎸夐挳 */
.preview-btn {
  background-color: #4CAF50;
  border-radius: 8rpx;
  padding: 10rpx 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.preview-text {
  font-size: 14rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.preview-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 杞︽崯鎷嶆憚杩涘害淇℃伅 */
.damage-info {
  background-color: #FFFFFF;
  border-radius: 8rpx;
  padding: 14rpx 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.damage-count {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 6rpx;
}

.count-label {
  font-size: 12rpx;
  color: #9E9E9E;
}

.count-value {
  font-size: 18rpx;
  color: #4CAF50;
  font-weight: 600;
}

.damage-progress {
  margin-top: 6rpx;
}

.damage-tip {
  text-align: center;
}

.damage-tip text {
  font-size: 12rpx;
  color: #757575;
}

/* 瀹屾垚鎷嶆憚鎸夐挳 */
.finish-btn {
  background-color: #FFFFFF;
  border: 2rpx solid #4CAF50;
  border-radius: 8rpx;
  padding: 10rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.finish-text {
  font-size: 14rpx;
  color: #4CAF50;
  font-weight: 500;
}

.finish-btn:active {
  background-color: #E8F5E9;
  transform: scale(0.98);
}

/* 鎷嶇収鍖哄煙 */
.camera-wrapper {
  position: relative;
  z-index: 1;
  width: 400rpx;
  height: 300rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  background-color: #FFFFFF;
  flex-shrink: 0;
}

.camera {
  width: 100%;
  height: 100%;
}

/* 杈呭姪妗嗗鍣?*/
.guide-container {
  width: 100%;
  height: 100%;
  position: relative;
}

/* 鎻愮ず鏂囧瓧 - 鍥哄畾鍦ㄩ《閮?*/
.guide-tip {
  background-color: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 16rpx;
  padding: 6rpx 14rpx;
  border-radius: 14rpx;
  position: absolute;
  top: 4%;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  z-index: 4;
}

.damage-debug {
  position: absolute;
  top: 14.6667%;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(0, 0, 0, 0.45);
  color: rgba(255, 255, 255, 0.92);
  font-size: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  white-space: nowrap;
  z-index: 4;
}

.ai-tip {
  position: absolute;
  left: 50%;
  bottom: 4.6667%;
  transform: translateX(-50%);
  background-color: rgba(33, 33, 33, 0.72);
  color: #FFFFFF;
  font-size: 14rpx;
  padding: 6rpx 16rpx;
  border-radius: 14rpx;
  white-space: nowrap;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  z-index: 4;
}

.ai-tip-locked {
  background-color: rgba(76, 175, 80, 0.92);
  box-shadow: 0 0 0 2rpx rgba(76, 175, 80, 0.24);
}


/* 杈呭姪妗嗗熀纭€鏍峰紡 */
.guide-frame {
  border: 4rpx solid #4CAF50;
  position: absolute;
  box-shadow: 0 0 0 2rpx rgba(76, 175, 80, 0.26);
}

/* 杞︾墝杈呭姪妗?*/
.guide-frame-license {
  width: 50%;
  height: 22.6667%;
  border-radius: 6rpx;
  bottom: 18.6667%;
  left: 50%;
  transform: translateX(-50%);
}

.guide-frame-license-detected {
  border-color: #FFB300;
  box-shadow: 0 0 0 2rpx rgba(255, 179, 0, 0.24);
  background-color: rgba(255, 179, 0, 0.08);
}

.guide-frame-license-stable {
  border-color: #29B6F6;
  box-shadow: 0 0 0 2rpx rgba(41, 182, 246, 0.26);
  background-color: rgba(41, 182, 246, 0.08);
}

.guide-frame-license-locked {
  border-color: #1565C0;
  box-shadow: 0 0 0 3rpx rgba(21, 101, 192, 0.28);
  background-color: rgba(21, 101, 192, 0.10);
}

.plate-distance-hint {
  position: absolute;
  left: 50%;
  bottom: 42%;
  transform: translateX(-50%);
  width: 46%;
  height: 30.6667%;
  z-index: 4;
  pointer-events: none;
}

.plate-distance-arrows {
  position: absolute;
  left: 50%;

<!-- 预览页 -->
<view class="page">
  <view class="page-glow"></view>

  <view class="topbar">
    <view class="title-wrap">
      <text class="page-title">照片预览</text>
      <text class="page-subtitle">请确认照片清晰，并按车辆补充行驶证资料</text>
    </view>
  </view>

  <!-- 主界面：车辆照片列表 -->
  <scroll-view scroll-y class="grid-view" scroll-into-view="{{scrollToView}}" scroll-with-animation="{{true}}">
    <view class="vehicle-section" wx:for="{{vehicles}}" wx:key="id">
      <view class="vehicle-header">
        <view class="vehicle-title-wrap">
          <text class="vehicle-title">{{item.previewName}}</text>
          <text class="vehicle-tag">{{item.previewTag}}</text>
        </view>
        <view wx:if="{{index > 0}}" class="delete-btn" bindtap="onDeleteVehicle" data-vehicle-index="{{index}}">删除此车</view>
      </view>

      <view class="photo-grid">
        <!-- 车牌 -->
        <view wx:if="{{item.licensePlate.status === 'completed'}}"
              class="photo-item"
              bindtap="onPreview"
              data-vehicle="{{index}}"
              data-type="licensePlate">
          <view class="thumb">
            <image src="{{item.licensePlate.compressedPath}}" mode="aspectFill"></image>
            <view wx:if="{{item.licensePlate.captureMode === 'auto'}}" class="capture-badge">自动</view>
            <view class="check">✓</view>
          </view>
          <text class="photo-label">车牌</text>
        </view>
        <view wx:else class="photo-item" bindtap="onSupplement" data-vehicle="{{index}}" data-type="licensePlate">
          <view class="thumb empty-thumb">
            <text class="plus">+</text>
          </view>
          <text class="photo-label">车牌</text>
        </view>

        <!-- VIN码 -->
        <view wx:if="{{item.vinCode.status === 'completed'}}"
              class="photo-item"
              bindtap="onPreview"
              data-vehicle="{{index}}"
              data-type="vinCode">
          <view class="thumb">
            <image src="{{item.vinCode.compressedPath}}" mode="aspectFill"></image>
            <view wx:if="{{item.vinCode.captureMode === 'auto'}}" class="capture-badge">自动</view>
            <view class="check">✓</view>
          </view>
          <text class="photo-label">VIN</text>
        </view>
        <view wx:else class="photo-item" bindtap="onSupplement" data-vehicle="{{index}}" data-type="vinCode">
          <view class="thumb empty-thumb">
            <text class="plus">+</text>
          </view>
          <text class="photo-label">VIN</text>
        </view>

        <!-- 车损 -->
        <block wx:for="{{item.damages}}" wx:for-item="damage" wx:for-index="dIndex" wx:key="index">
          <view class="photo-item"
                bindtap="onPreview"
                data-vehicle="{{index}}"
                data-type="damage"
                data-damage="{{dIndex}}">
            <view class="thumb">
              <image src="{{damage.compressedPath}}" mode="aspectFill"></image>
              <view wx:if="{{damage.captureMode === 'auto'}}" class="capture-badge">自动</view>
              <view class="check">✓</view>
            </view>
            <text class="photo-label">车损{{dIndex + 1}}</text>
          </view>
        </block>

        <!-- 添加车损：保留原补拍入口，行驶证仍保持列表最后 -->
        <view wx:if="{{item.licensePlate.status === 'completed' && item.vinCode.status === 'completed' && (!item.damages || item.damages.length < 5)}}"
              class="photo-item"
              bindtap="onAddDamage"
              data-vehicle="{{index}}">
          <view class="thumb add-thumb">
            <text class="plus">+</text>
          </view>
          <text class="photo-label">{{item.damages && item.damages.length > 0 ? '添加车损' : '拍摄车损'}}</text>
        </view>

        <!-- 行驶证资料 -->
        <block wx:if="{{item.drivingLicensePreview.items.length > 0}}">
          <block wx:for="{{item.drivingLicensePreview.items}}" wx:for-item="license" wx:for-index="licenseIndex" wx:key="label">
            <view class="photo-item"
                  bindtap="onPreview"
                  data-vehicle="{{index}}"
                  data-type="vehicleDocument"
                  data-doc-type="{{license.docType}}"
                  data-doc-side="{{license.docSide}}">
              <view class="thumb">
                <image src="{{license.compressedPath}}" mode="aspectFill"></image>
                <view class="check">✓</view>
              </view>
              <text class="photo-label">{{license.label}}</text>
            </view>
          </block>
        </block>
        <view wx:if="{{item.drivingLicensePreview.showUploadEntry}}" class="photo-item" bindtap="onOpenDrivingLicensePanel" data-vehicle="{{index}}">
          <view class="thumb upload-license-thumb">
            <view class="plus-circle">+</view>
            <text class="upload-license-text">上传行驶证</text>
          </view>
          <text class="photo-label">行驶证资料</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部提示栏 -->
  <view class="bottom-bar">
    <view class="tip">
      <view class="tip-icon">i</view>
      <text class="tip-text">行驶证资料未完成上传，可能影响后续智能定损和理赔处理。</text>
    </view>
    <view class="bottom-actions">
      <view wx:if="{{canAddThirdVehicle}}" class="btn btn-ghost" bindtap="onAddThirdVehicle">添加三者车</view>
      <view class="btn btn-primary" bindtap="onSubmit">完成采集</view>
    </view>
  </view>

  <!-- 行驶证资料弹层 -->
  <view wx:if="{{showDrivingLicensePanel}}" class="license-panel-mask" bindtap="onCloseDrivingLicensePanel">
    <view class="license-panel" catchtap="stopPropagation">
      <view class="license-panel-header">
        <text class="license-panel-title">{{drivingLicenseMode === 'electronic' ? '电子行驶证' : '行驶证资料'}}</text>
        <view class="license-panel-close" bindtap="onCloseDrivingLicensePanel">×</view>
      </view>

      <view class="license-upload-row {{activeDrivingLicenseSlots.length === 1 ? 'single' : ''}}">
        <view wx:for="{{activeDrivingLicenseSlots}}"
              wx:key="docSide"
              class="license-upload-slot {{activeDrivingLicenseSlots.length === 1 ? 'electronic' : ''}} {{item.uploaded ? 'uploaded' : ''}}"
              bindtap="onTapDrivingLicenseSlot"
              data-side="{{item.docSide}}"
              data-uploaded="{{item.uploaded}}">
          <block wx:if="{{item.uploaded}}">
            <image class="slot-image" src="{{item.document.compressedPath}}" mode="aspectFill"></image>
            <text class="slot-title">已上传</text>
            <text class="slot-subtitle">{{item.label}}</text>
          </block>
          <block wx:else>
            <view class="plus-circle">+</view>
            <text class="slot-title">{{item.label}}</text>
          </block>
        </view>
      </view>

      <view class="license-switch" bindtap="onSwitchDrivingLicenseMode">
        {{drivingLicenseMode === 'electronic' ? '改传实体行驶证' : '改传电子行驶证'}}
      </view>
    </view>
  </view>

  <!-- 全屏预览（点击照片后显示） -->
  <view wx:if="{{showPreview}}" class="fullscreen-preview">
    <swiper class="preview-swiper"
            current="{{previewIndex}}"
            bindchange="onSwiperChange"
            circular="{{false}}">
      <swiper-item wx:for="{{allPhotos}}" wx:key="id">
        <image class="preview-image" src="{{item.url}}" mode="aspectFit" bindtap="onToggleActions"></image>
      </swiper-item>
    </swiper>

    <view class="preview-header {{actionsVisible ? '' : 'hidden'}}">
      <view class="close-btn" bindtap="onClosePreview">关闭</view>
      <text class="preview-count">{{previewIndex + 1}} / {{allPhotos.length}}</text>
      <view class="placeholder"></view>
    </view>

    <view class="preview-label {{actionsVisible ? '' : 'hidden'}}">{{currentPhoto.label}}</view>
    <view wx:if="{{actionsVisible && currentPhoto && currentPhoto.captureMode}}" class="preview-mode-tag">
      {{currentPhoto.captureMode === 'auto' ? 'AI自动拍摄' : '手动拍摄'}}
    </view>

    <view class="preview-footer {{actionsVisible ? '' : 'hidden'}}">
      <view class="preview-btn" bindtap="onRetake">重拍</view>
      <view class="preview-btn danger" bindtap="onDelete">删除</view>
    </view>
  </view>

  <confirm-modal
    visible="{{showModal}}"
    content="{{modalContent}}"
    confirm-text="{{modalConfirmText}}"
    cancel-text="{{modalCancelText}}"
    bind:confirm="onModalConfirm"
    bind:cancel="onModalCancel"
    bind:masktap="onModalMaskTap"
  />
</view>

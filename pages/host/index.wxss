.host-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 56rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}

.host-header {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.host-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #17202a;
}

.host-subtitle {
  font-size: 26rpx;
  color: #5f6b7a;
}

.host-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.host-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #17202a;
  background: #ffffff;
}

.host-button.primary {
  color: #ffffff;
  background: #2f7d59;
}

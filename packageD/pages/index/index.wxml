<!-- 首页 -->
<view class="container">
  <view class="page-glow"></view>

  <!-- 左上角品牌标识 -->
  <view class="brand" bindtap="onBrandTap">
    <image class="brand-logo" src="/packageD/assets/logo.png" mode="aspectFit"></image>
  </view>

  <!-- 主体内容 -->
  <view class="content">
    <view class="hero">
      <text class="title">车辆损失照片采集工具</text>
      <text class="subtitle">请按照提示完成车辆信息、车损照片及单证资料采集</text>
    </view>

    <view class="notice-card">
      <view class="notice-header">
        <view class="notice-bar"></view>
        <text class="notice-title">拍摄须知</text>
      </view>

      <view class="notice-list">
        <view class="notice-item">
          <view class="index-badge">
            <text class="index-text">1</text>
          </view>
          <text class="notice-text">拍摄前，请提前准备好事故车辆驾驶证、行驶证</text>
        </view>

        <view class="notice-item">
          <view class="index-badge">
            <text class="index-text">2</text>
          </view>
          <text class="notice-text">依次拍摄您的车（标的车）、其他出险车辆（三者车）的车牌号、VIN码和车损部位</text>
        </view>

        <view class="notice-item">
          <view class="index-badge">
            <text class="index-text">3</text>
          </view>
          <text class="notice-text">拍摄时，请注意安全，并尽量在网络畅通处完成上传</text>
        </view>
      </view>
    </view>

    <view class="actions">
      <button class="start-button" bindtap="onStart">开始采集</button>
      <text class="permission-note">ⓘ 开始采集后将使用摄像头拍摄照片，确认后的照片将尝试保存至手机相册。</text>
    </view>
  </view>

  <view wx:if="{{appEnvBadgeText}}" class="env-badge">{{appEnvBadgeText}}</view>
</view>

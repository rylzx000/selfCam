@import "../../styles/common.wxss";
/* 预览页样式 */

page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #eef4ef;
}

.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  padding: 24rpx 30rpx 22rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: #f7faf8;
  color: #1f2933;
  display: flex;
  flex-direction: column;
}

.page-glow {
  position: absolute;
  top: -92rpx;
  right: -78rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: rgba(0, 160, 96, 0.08);
  z-index: 0;
}

.topbar {
  position: relative;
  z-index: 1;
  height: 54rpx;
  min-height: 54rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.title-wrap {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 28rpx;
  line-height: 32rpx;
  font-weight: 650;
  color: #1f2933;
}

.page-subtitle {
  margin-top: 4rpx;
  font-size: 14rpx;
  line-height: 20rpx;
  color: #667085;
}

.top-actions {
  display: flex;
  align-items: center;
  padding-top: 4rpx;
}

.btn {
  height: 36rpx;
  min-width: 96rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14rpx;
  line-height: 1;
  font-weight: 600;
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.95);
  color: #3d4a46;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.btn-ghost:active {
  background: #f3f6f4;
}

.btn-primary {
  background: #009b63;
  color: #ffffff;
  box-shadow: 0 7rpx 16rpx rgba(0, 155, 99, 0.18);
}

.btn-primary:active {
  opacity: 0.9;
}

/* 车辆照片列表 */
.grid-view {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 0;
  padding-bottom: 58rpx;
  box-sizing: border-box;
}

.vehicle-section {
  min-height: 150rpx;
  margin-bottom: 12rpx;
  padding: 14rpx 16rpx 15rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.065);
}

.vehicle-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.vehicle-title-wrap {
  display: flex;
  align-items: center;
  min-width: 0;
}

.vehicle-title {
  font-size: 18rpx;
  line-height: 22rpx;
  font-weight: 650;
  color: #1f2933;
}

.vehicle-tag {
  height: 22rpx;
  margin-left: 10rpx;
  padding: 0 9rpx;
  border-radius: 999rpx;
  background: rgba(0, 155, 99, 0.10);
  color: #008f55;
  font-size: 12rpx;
  line-height: 22rpx;
  font-weight: 600;
}

.delete-btn {
  height: 26rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(211, 47, 47, 0.16);
  background: rgba(211, 47, 47, 0.06);
  color: #d32f2f;
  font-size: 12rpx;
  line-height: 26rpx;
}

.delete-btn:active {
  background: rgba(211, 47, 47, 0.12);
}

.photo-grid {
  display: flex;
  flex-wrap: nowrap;
  gap: 10rpx;
  overflow-x: auto;
  overflow-y: hidden;
}

.photo-item {
  width: 112rpx;
  flex: 0 0 112rpx;
}

.thumb {
  position: relative;
  width: 112rpx;
  height: 72rpx;
  border-radius: 9rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  background: linear-gradient(135deg, #d8dee6, #f8fafc);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.thumb image {
  width: 112rpx;
  height: 72rpx;
  display: block;
  background: #e0e5e1;
}

.capture-badge {
  position: absolute;
  top: 5rpx;
  right: 5rpx;
  height: 16rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: rgba(0, 155, 99, 0.92);
  color: #ffffff;
  font-size: 10rpx;
  line-height: 16rpx;
}

.check {
  position: absolute;
  right: 5rpx;
  bottom: 5rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #009b63;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12rpx;
  line-height: 18rpx;
  box-shadow: 0 2rpx 5rpx rgba(0, 155, 99, 0.28);
}

.photo-label {
  display: block;
  margin-top: 6rpx;
  text-align: center;
  font-size: 13rpx;
  line-height: 16rpx;
  color: #4b5563;
  white-space: nowrap;
}

.empty-thumb,
.add-thumb {
  border-style: dashed;
  background: rgba(248, 251, 249, 0.96);
}

.empty-thumb {
  border-color: #c5cec8;
}

.add-thumb {
  border-color: rgba(0, 155, 99, 0.36);
}

.plus {
  color: #008f55;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 300;
}

.license-thumb {
  background: linear-gradient(135deg, #eefdf6, #ffffff);
  border-color: rgba(0, 155, 99, 0.20);
  color: #008f55;
}

.license-card-art {
  position: absolute;
  left: 12rpx;
  top: 13rpx;
  width: 45rpx;
  height: 44rpx;
  border-radius: 5rpx;
  background: rgba(0, 155, 99, 0.08);
  border: 1rpx solid rgba(0, 155, 99, 0.12);
}

.license-line {
  height: 3rpx;
  margin: 6rpx 7rpx 0;
  border-radius: 999rpx;
  background: rgba(0, 155, 99, 0.22);
}

.license-line-main {
  width: 22rpx;
  margin-top: 9rpx;
}

.license-line.short {
  width: 18rpx;
}

.license-thumb-text {
  margin-left: 42rpx;
  color: #008f55;
  font-size: 13rpx;
  line-height: 18rpx;
  font-weight: 650;
}

.upload-license-thumb {
  border: 1.5rpx dashed rgba(0, 155, 99, 0.42);
  background: rgba(248, 251, 249, 0.96);
  color: #008f55;
  flex-direction: column;
}

.plus-circle {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(0, 155, 99, 0.10);
  color: #008f55;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 500;
}

.upload-license-text {
  margin-top: 5rpx;
  font-size: 13rpx;
  line-height: 16rpx;
  color: #008f55;
  font-weight: 600;
}

.module-one-section {
  position: relative;
}

.module-one-warning {
  margin-bottom: 10rpx;
  padding: 8rpx 10rpx;
  border-radius: 8rpx;
  background: #fff7e6;
  color: #8a5a00;
  font-size: 12rpx;
  line-height: 17rpx;
}

.module-one-vehicles-scroll {
  width: 100%;
  white-space: nowrap;
}

.module-one-vehicles-row {
  display: inline-flex;
  gap: 12rpx;
  min-width: 100%;
}

.module-one-vehicle-card {
  width: 228rpx;
  padding: 10rpx;
  border-radius: 10rpx;
  background: rgba(248, 251, 249, 0.96);
  border: 1rpx solid rgba(0, 155, 99, 0.12);
  box-sizing: border-box;
}

.final-group {
  margin-bottom: 12rpx;
}

.doc-package-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.doc-package-card {
  padding: 8rpx 10rpx 9rpx;
  border-radius: 9rpx;
  background: rgba(248, 251, 249, 0.96);
  border: 1rpx solid rgba(0, 155, 99, 0.1);
  box-sizing: border-box;
}

.doc-package-vehicle {
  margin-bottom: 7rpx;
  color: #1f2933;
  font-size: 12rpx;
  line-height: 16rpx;
  font-weight: 750;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.doc-package-scroll {
  width: 100%;
  white-space: nowrap;
}

.doc-package-actions {
  display: inline-flex;
  flex-wrap: nowrap;
  gap: 8rpx;
  padding-bottom: 1rpx;
}

.doc-package-tile {
  width: 92rpx;
  flex: 0 0 92rpx;
}

.module-one-vehicle-title {
  margin-bottom: 8rpx;
  color: #1f2933;
  font-size: 14rpx;
  line-height: 18rpx;
  font-weight: 650;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.module-one-vehicle-slots {
  display: flex;
  gap: 10rpx;
}

.module-one-slot {
  width: 96rpx;
  flex: 0 0 96rpx;
}

/* 底部提示栏 */
.bottom-bar {
  position: absolute;
  z-index: 2;
  left: 30rpx;
  right: 30rpx;
  bottom: 20rpx;
  height: 44rpx;
  padding: 0 12rpx 0 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(0, 155, 99, 0.12);
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.055);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-sizing: border-box;
}

.tip {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #7a8699;
}

.tip-icon {
  width: 20rpx;
  height: 20rpx;
  flex: 0 0 20rpx;
  border-radius: 50%;
  border: 1rpx solid #aab4c0;
  color: #8a94a3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13rpx;
  line-height: 20rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.tip-text {
  min-width: 0;
  font-size: 13rpx;
  line-height: 18rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bottom-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.bottom-actions .btn {
  height: 32rpx;
  min-width: 108rpx;
  border-radius: 9rpx;
  font-size: 13rpx;
}

/* 证件信息弹层 */
.license-panel-mask {
  position: fixed;
  z-index: 1100;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
}

.license-panel {
  width: 430rpx;
  padding: 18rpx 20rpx 20rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(0, 155, 99, 0.12);
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.16);
}

.license-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.license-panel-title {
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 650;
  color: #1f2933;
}

.license-panel-close {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #f3f6f4;
  color: #667085;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  line-height: 28rpx;
}

.license-panel-close:active {
  background: #e8eee9;
}

.license-upload-row {
  display: flex;
  gap: 12rpx;
}

.license-upload-row.single {
  justify-content: center;
}

.license-upload-slot {
  position: relative;
  height: 104rpx;
  flex: 1;
  border: 1.5rpx dashed rgba(0, 155, 99, 0.38);
  border-radius: 10rpx;
  background: #f8fbf9;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.license-upload-slot.uploaded {
  border-style: solid;
  border-color: rgba(0, 155, 99, 0.20);
  background: linear-gradient(135deg, #eefdf6, #ffffff);
}

.license-upload-slot.electronic {
  max-width: 204rpx;
}

.license-upload-slot:active {
  background: #eef8f2;
}

.slot-title {
  margin-top: 8rpx;
  color: #008f55;
  font-size: 14rpx;
  line-height: 18rpx;
  font-weight: 600;
}

.slot-subtitle {
  margin-top: 3rpx;
  color: #7a8699;
  font-size: 11rpx;
  line-height: 14rpx;
}

.slot-image {
  width: 76rpx;
  height: 44rpx;
  border-radius: 7rpx;
  border: 1rpx solid rgba(0, 155, 99, 0.18);
  display: block;
  background: #e0e5e1;
}

.license-switch {
  margin-top: 14rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #008f55;
  font-size: 13rpx;
  line-height: 30rpx;
  font-weight: 600;
}

.license-switch:active {
  opacity: 0.75;
}

/* 全屏预览 */
.fullscreen-preview {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #000000;
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

.preview-swiper {
  flex: 1;
  width: 100%;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.preview-header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 44rpx;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.6), transparent);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx;
  transition: opacity 0.3s;
}

.preview-header.hidden {
  opacity: 0;
  pointer-events: none;
}

.close-btn {
  font-size: 14rpx;
  color: #ffffff;
  padding: 6rpx 12rpx;
}

.preview-count {
  font-size: 14rpx;
  color: #ffffff;
}

.placeholder {
  width: 50rpx;
}

.preview-label {
  position: absolute;
  top: 44rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 14rpx;
  color: rgba(255, 255, 255, 0.8);
  transition: opacity 0.3s;
}

.preview-label.hidden {
  opacity: 0;
}

.preview-mode-tag {
  position: absolute;
  top: 66rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 12rpx;
  color: #ffffff;
  padding: 6rpx 12rpx;
  background-color: rgba(0, 155, 99, 0.82);
  border-radius: 14rpx;
}

.preview-footer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  transition: opacity 0.3s;
}

.preview-footer.hidden {
  opacity: 0;
  pointer-events: none;
}

.preview-btn {
  font-size: 14rpx;
  color: #ffffff;
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 6rpx;
}

.preview-btn.danger {
  border-color: #ffcdd2;
  color: #ffcdd2;
}

.preview-btn:active {
  opacity: 0.8;
}

.upload-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background-color: rgba(12, 20, 16, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-modal {
  width: 340rpx;
  min-height: 172rpx;
  padding: 22rpx 22rpx 18rpx;
  border-radius: 10rpx;
  background-color: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(0, 0, 0, 0.22);
}

.upload-modal-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.upload-mark {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background-color: #e6f4ed;
  color: #1f8f5f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.upload-mark.danger {
  background-color: #fdebe8;
  color: #c9483a;
}

.upload-title-wrap {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.upload-title {
  font-size: 18rpx;
  line-height: 24rpx;
  font-weight: 700;
  color: #17231b;
}

.upload-desc {
  margin-top: 2rpx;
  color: #6d7b72;
  font-size: 12rpx;
  line-height: 17rpx;
}

.upload-progress-meta {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  color: #6d7b72;
  font-size: 12rpx;
  line-height: 16rpx;
}

.upload-percent {
  color: #13784e;
  font-weight: 700;
}

.upload-progress-track {
  margin-top: 7rpx;
  height: 9rpx;
  border-radius: 5rpx;
  background-color: #e7eee9;
  overflow: hidden;
}

.upload-progress-fill {
  height: 100%;
  border-radius: 5rpx;
  background-color: #1f8f5f;
}

.upload-progress-fill.danger {
  background-color: #c9483a;
}

.upload-current {
  margin-top: 10rpx;
  color: #6d7b72;
  font-size: 12rpx;
  line-height: 17rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.upload-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.upload-primary {
  min-width: 78rpx;
  height: 32rpx;
  padding: 0 12rpx;
  border-radius: 7rpx;
  background-color: #1f8f5f;
  color: #ffffff;
  font-size: 13rpx;
  line-height: 32rpx;
  font-weight: 700;
  text-align: center;
}

.upload-primary.danger {
  background-color: #c9483a;
}

.module-one-handoff {
  min-height: 140rpx;
}

.module-one-next {
  margin-top: 18rpx;
  padding: 10rpx 12rpx;
  border-radius: 8rpx;
  background: #eef8f2;
  color: #13784e;
  font-size: 14rpx;
  line-height: 18rpx;
  font-weight: 700;
}

.module-one-secondary {
  margin-right: 10rpx;
  background-color: #f3f6f4;
  color: #3d4a46;
}

@media (max-height: 560px) {
  .page {
    padding: 18rpx 26rpx 18rpx;
  }

  .topbar {
    height: 46rpx;
    min-height: 46rpx;
    margin-bottom: 10rpx;
  }

  .page-title {
    font-size: 24rpx;
    line-height: 28rpx;
  }

  .page-subtitle {
    font-size: 12rpx;
    line-height: 17rpx;
  }

  .vehicle-section {
    min-height: 136rpx;
    padding: 12rpx 14rpx;
  }

  .vehicle-header {
    margin-bottom: 10rpx;
  }

  .photo-item {
    width: 102rpx;
    flex-basis: 102rpx;
  }

  .thumb,
  .thumb image {
    width: 102rpx;
    height: 64rpx;
  }

  .photo-label {
    font-size: 12rpx;
  }

  .bottom-bar {
    left: 26rpx;
    right: 26rpx;
    bottom: 16rpx;
    height: 40rpx;
  }

  .tip-text {
    font-size: 12rpx;
  }
}

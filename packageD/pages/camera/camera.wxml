<view class="container" style="{{cameraLayout.containerStyle}}">
  <view class="page-glow"></view>

  <view class="info-area" style="{{cameraLayout.infoAreaStyle}}">
    <view class="vehicle-info" style="{{cameraLayout.vehicleCardStyle}}">
      <text class="vehicle-label" style="{{cameraLayout.labelTextStyle}}">当前车辆</text>
      <view class="vehicle-main">
        <text class="vehicle-role" style="{{cameraLayout.primaryTextStyle}}">{{vehicleRoleName}}</text>
      </view>
      <text class="vehicle-plate vehicle-plate-{{vehiclePlateTheme}}">{{vehiclePlateNo}}</text>
    </view>

    <view wx:if="{{currentStep !== 'damage'}}" class="step-info" style="{{cameraLayout.cardStyle}}">
      <text class="step-label" style="{{cameraLayout.labelTextStyle}}">拍摄步骤</text>
      <text class="step-name" style="{{cameraLayout.secondaryTextStyle}}">{{stepDisplayName}}</text>
    </view>

    <view wx:if="{{currentStep === 'damage'}}" class="damage-info" style="{{cameraLayout.damageCardStyle}}">
      <view class="damage-count">
        <view class="damage-count-header">
          <text class="count-label" style="{{cameraLayout.labelTextStyle}}">车损照片</text>
          <text wx:if="{{vehicleProgressText}}" class="vehicle-progress damage-progress">{{vehicleProgressText}}</text>
        </view>
        <text class="count-value damage-count-value" style="{{cameraLayout.damageCountTextStyle}}">{{damageCountText}}</text>
      </view>

    </view>

    <view class="side-bottom">
      <view class="preview-btn" style="{{cameraLayout.sideActionButtonStyle}}" bindtap="onGoPreview">
        <text class="preview-text" style="{{cameraLayout.actionButtonTextStyle}}">{{previewButtonText}}</text>
      </view>

      <view wx:if="{{currentStep === 'damage'}}" class="finish-btn" style="{{cameraLayout.sideActionButtonStyle}}" bindtap="onFinishDamage">
        <text class="finish-text" style="{{cameraLayout.actionButtonTextStyle}}">{{finishDamageText}}</text>
      </view>

      <view
        wx:if="{{currentStep === 'scene45' || currentStep === 'damage'}}"
        class="side-guide-entry"
        data-guide="{{currentStep === 'damage' ? 'damage' : 'scene45'}}"
        bindtap="onOpenCaptureGuide"
      >
        <view class="side-guide-icon">
          <view wx:if="{{currentStep === 'scene45'}}" class="mini-scene-car"></view>
          <view wx:if="{{currentStep === 'damage'}}" class="mini-damage-steps">
            <view></view>
            <view></view>
            <view></view>
          </view>
        </view>
        <view class="side-guide-copy">
          <text class="side-guide-main">拍摄指引</text>
          <text class="side-guide-tag">{{currentStep === 'damage' ? '远 / 中 / 近' : '45度'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="camera-wrapper" style="{{cameraLayout.cameraWrapperStyle}}">
    <camera
      wx:if="{{cameraMounted && !showConfirmModal && !showDamageCompleteModal}}"
      class="camera"
      device-position="back"
      flash="auto"
      frame-size="medium"
      binderror="onCameraError"
      bindstop="onCameraStop"
      bindinitdone="onCameraInitDone"
    >
      <cover-view class="guide-container">
        <cover-view
          wx:if="{{currentStep === 'licensePlate'}}"
          class="guide-frame guide-frame-license guide-frame-license-{{plateFrameState}}"
          style="{{cameraLayout.plateFrameStyle}} {{cameraLayout.guideFrameStyle}}"
        ></cover-view>
        <cover-view
          wx:if="{{currentStep === 'licensePlate' && plateDistanceHint}}"
          class="plate-distance-hint plate-distance-hint-{{plateDistanceHint}}"
        >
          <cover-view class="plate-distance-arrows">
            <cover-view class="plate-distance-frame" hidden="{{plateBlinkFrame !== 'a'}}">
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-1"
                src="{{plateDistanceHint === 'forward' ? '/packageD/assets/arrow-up-blue.png' : '/packageD/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-2"
                src="{{plateDistanceHint === 'forward' ? '/packageD/assets/arrow-up-white.png' : '/packageD/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-3"
                src="{{plateDistanceHint === 'forward' ? '/packageD/assets/arrow-up-blue.png' : '/packageD/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-4"
                src="{{plateDistanceHint === 'forward' ? '/packageD/assets/arrow-up-white.png' : '/packageD/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-5"
                src="{{plateDistanceHint === 'forward' ? '/packageD/assets/arrow-up-blue.png' : '/packageD/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-6"
                src="{{plateDistanceHint === 'forward' ? '/packageD/assets/arrow-up-white.png' : '/packageD/assets/arrow-down-white.png'}}"
              ></cover-image>
            </cover-view>
            <cover-view class="plate-distance-frame" hidden="{{plateBlinkFrame !== 'b'}}">
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-1"
                src="{{plateDistanceHint === 'forward' ? '/packageD/assets/arrow-up-white.png' : '/packageD/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-2"
                src="{{plateDistanceHint === 'forward' ? '/packageD/assets/arrow-up-blue.png' : '/packageD/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-3"
                src="{{plateDistanceHint === 'forward' ? '/packageD/assets/arrow-up-white.png' : '/packageD/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-4"
                src="{{plateDistanceHint === 'forward' ? '/packageD/assets/arrow-up-blue.png' : '/packageD/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-5"
                src="{{plateDistanceHint === 'forward' ? '/packageD/assets/arrow-up-white.png' : '/packageD/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="plate-distance-arrow plate-distance-arrow-6"
                src="{{plateDistanceHint === 'forward' ? '/packageD/assets/arrow-up-blue.png' : '/packageD/assets/arrow-down-blue.png'}}"
              ></cover-image>
            </cover-view>
          </cover-view>
        </cover-view>
        <cover-view
          wx:if="{{currentStep === 'vinCode'}}"
          class="guide-frame guide-frame-vin"
          style="{{cameraLayout.guideFrameStyle}}"
        ></cover-view>
        <cover-view
          wx:if="{{currentStep === 'scene45'}}"
          class="guide-frame guide-frame-scene guide-frame-scene-45"
          style="{{cameraLayout.damageFrameStyle}} {{cameraLayout.guideFrameStyle}}"
        ></cover-view>
        <cover-view
          wx:if="{{currentStep === 'sceneSupplement'}}"
          class="guide-frame guide-frame-scene guide-frame-scene-supplement"
          style="{{cameraLayout.damageFrameStyle}} {{cameraLayout.guideFrameStyle}}"
        ></cover-view>
        <cover-view
          wx:if="{{currentStep === 'damage'}}"
          class="guide-frame guide-frame-damage guide-frame-damage-{{damageFrameState}}"
          style="{{cameraLayout.damageFrameStyle}} {{cameraLayout.guideFrameStyle}}"
        >
          <cover-view class="cross-h" style="{{cameraLayout.crossHStyle}}"></cover-view>
          <cover-view class="cross-v" style="{{cameraLayout.crossVStyle}}"></cover-view>
        </cover-view>
        <cover-view
          wx:if="{{currentStep === 'damage' && damageDistanceHint}}"
          class="damage-distance-hint"
        >
          <cover-view class="damage-distance-arrows">
            <cover-view class="damage-distance-frame" hidden="{{plateBlinkFrame !== 'a'}}">
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-1"
                src="{{damageDistanceHint === 'forward' ? '/packageD/assets/arrow-up-blue.png' : '/packageD/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-2"
                src="{{damageDistanceHint === 'forward' ? '/packageD/assets/arrow-up-white.png' : '/packageD/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-3"
                src="{{damageDistanceHint === 'forward' ? '/packageD/assets/arrow-up-blue.png' : '/packageD/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-4"
                src="{{damageDistanceHint === 'forward' ? '/packageD/assets/arrow-up-white.png' : '/packageD/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-5"
                src="{{damageDistanceHint === 'forward' ? '/packageD/assets/arrow-up-blue.png' : '/packageD/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-6"
                src="{{damageDistanceHint === 'forward' ? '/packageD/assets/arrow-up-white.png' : '/packageD/assets/arrow-down-white.png'}}"
              ></cover-image>
            </cover-view>
            <cover-view class="damage-distance-frame" hidden="{{plateBlinkFrame !== 'b'}}">
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-1"
                src="{{damageDistanceHint === 'forward' ? '/packageD/assets/arrow-up-white.png' : '/packageD/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-2"
                src="{{damageDistanceHint === 'forward' ? '/packageD/assets/arrow-up-blue.png' : '/packageD/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-3"
                src="{{damageDistanceHint === 'forward' ? '/packageD/assets/arrow-up-white.png' : '/packageD/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-4"
                src="{{damageDistanceHint === 'forward' ? '/packageD/assets/arrow-up-blue.png' : '/packageD/assets/arrow-down-blue.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-5"
                src="{{damageDistanceHint === 'forward' ? '/packageD/assets/arrow-up-white.png' : '/packageD/assets/arrow-down-white.png'}}"
              ></cover-image>
              <cover-image
                class="damage-distance-arrow damage-distance-arrow-6"
                src="{{damageDistanceHint === 'forward' ? '/packageD/assets/arrow-up-blue.png' : '/packageD/assets/arrow-down-blue.png'}}"
              ></cover-image>
            </cover-view>
          </cover-view>
        </cover-view>

        <cover-view class="guide-tip tip-{{currentStep}}" style="{{cameraLayout.guideTipStyle}}">
          {{currentStep === 'vinCode' ? vinGuideTip : guideTip}}
        </cover-view>

        <cover-view
          wx:if="{{currentStep === 'damage' && showDamageDebug && damageAreaRatioText}}"
          class="damage-debug"
          style="{{cameraLayout.damageDebugStyle}}"
        >
          {{damageAreaRatioText}}
        </cover-view>

        <cover-view wx:if="{{aiStatusText}}" class="ai-tip {{aiLocked ? 'ai-tip-locked' : ''}}" style="{{cameraLayout.aiTipStyle}}">
          {{aiStatusText}}
        </cover-view>
      </cover-view>
    </camera>

    <view wx:if="{{showConfirmModal}}" class="photo-preview">
      <image class="preview-image" src="{{pendingPhoto.compressedPath}}" mode="aspectFill"></image>
    </view>
  </view>

  <view class="action-area" style="{{cameraLayout.actionAreaStyle}}">
    <view wx:if="{{cameraMounted && !showConfirmModal && !showDamageCompleteModal && !showCaptureGuideModal}}" class="capture-section">
      <view class="capture-btn" style="{{cameraLayout.captureButtonStyle}}" bindtap="onCapture">
        <view class="capture-inner" style="{{cameraLayout.captureInnerStyle}}"></view>
      </view>
      <text class="capture-text" style="{{cameraLayout.captureTextStyle}}">{{aiEnabled && ((currentStep === 'licensePlate' && plateAIFeatureEnabled) || (currentStep === 'damage' && damageAIFeatureEnabled)) ? '手动拍照' : '点击拍照'}}</text>
    </view>

    <view wx:if="{{showConfirmModal}}" class="confirm-section" style="{{cameraLayout.confirmSectionStyle}}">
      <text wx:if="{{qualityHintText}}" class="quality-hint" style="{{cameraLayout.qualityHintStyle}}">{{qualityHintText}}</text>
      <view class="btn-group">
        <view class="btn-confirm" style="{{cameraLayout.confirmButtonStyle}}" bindtap="onConfirmPhoto">
          <text>{{confirmUseText}}</text>
        </view>
        <view class="btn-retake" style="{{cameraLayout.confirmButtonStyle}}" bindtap="onRetakePhoto">
          <text>{{retakeText}}</text>
        </view>
      </view>
    </view>
  </view>

  <confirm-modal
    visible="{{showDamageCompleteModal}}"
    title="{{damageCompleteModalTitle}}"
    content="{{damageCompleteModalContent}}"
    confirm-text="{{damageCompleteConfirmText}}"
    cancel-text="{{damageCompleteCancelText}}"
    show-cancel="{{damageCompleteShowCancel}}"
    bind:confirm="onDamageCompleteModalConfirm"
    bind:cancel="onDamageCompleteModalCancel"
    bind:masktap="onDamageCompleteModalMaskTap"
  />

  <view wx:if="{{showCaptureGuideModal}}" class="guide-modal-mask">
    <view class="guide-modal-card">
      <text class="guide-modal-title">{{captureGuideTitle}}</text>
      <text wx:if="{{captureGuideDescription}}" class="guide-modal-desc">{{captureGuideDescription}}</text>

      <view wx:if="{{captureGuideType === 'scene45'}}" class="guide-hero">
        <image
          class="guide-photo guide-photo-scene"
          src="/packageD/assets/images/capture-guides/scene-45deg.jpg"
          mode="aspectFit"
        ></image>
      </view>

      <view wx:if="{{captureGuideType === 'damage'}}" class="guide-triptych">
        <view class="guide-shot">
          <view class="guide-shot-visual">
            <image class="guide-photo" src="/packageD/assets/images/capture-guides/damage-far.jpg" mode="aspectFit"></image>
          </view>
          <text>远</text>
        </view>
        <view class="guide-shot">
          <view class="guide-shot-visual">
            <image class="guide-photo" src="/packageD/assets/images/capture-guides/damage-mid.jpg" mode="aspectFit"></image>
          </view>
          <text>中</text>
        </view>
        <view class="guide-shot">
          <view class="guide-shot-visual">
            <image class="guide-photo" src="/packageD/assets/images/capture-guides/damage-close.jpg" mode="aspectFit"></image>
          </view>
          <text>近</text>
        </view>
      </view>

      <view class="guide-modal-actions">
        <view class="guide-primary-btn" bindtap="onCaptureGuideConfirm">
          <text>{{captureGuideButtonText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{appEnvBadgeText}}" class="env-badge">{{appEnvBadgeText}}</view>
</view>

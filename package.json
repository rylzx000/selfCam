{
  "name": "selfcam-miniprogram",
  "version": "1.5.0",
  "description": "车辆定损拍摄小程序",
  "scripts": {
    "test": "jest",
    "test:e2e": "jest --config e2e/jest.config.js --runInBand",
    "test:e2e:capacity": "jest --config e2e/jest.config.js --runInBand --testPathPattern=capacity-boundary",
    "test:e2e:chaos": "jest --config e2e/jest.config.js --runInBand --testPathPattern=\"delete-retake-replenish|multi-vehicle-chaos|recovery-chaos\"",
    "test:e2e:p0": "jest --config e2e/jest.config.js --runInBand --testNamePattern=\"P0\"",
    "test:e2e:full": "jest --config e2e/jest.config.js --runInBand",
    "test:automator": "jest --config e2e/jest.config.js --runInBand",
    "test:automator:legacy": "node e2e/run-tests.js",
    "test:automator:smoke": "jest --config e2e/jest.config.js --runInBand --testNamePattern=\"首页|VIN|确认态\"",
    "mock:aux-photo": "node scripts/aux-photo-mock-server.js",
    "logs:collector": "node scripts/device-log-server.js",
    "logs:latest": "node scripts/read-device-log.js"
  },
  "devDependencies": {
    "miniprogram-automator": "^0.12.1",
    "jest": "^29.7.0"
  },
  "keywords": [
    "miniprogram",
    "wechat"
  ],
  "author": "",
  "license": "ISC"
}
